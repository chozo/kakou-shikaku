{
  "name": "kakou-shikaku",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check src/game.js && node --check src/main.js && node --check src/audio.js && node --check src/ai.js && node --check src/ai-worker.js",
    "e2e": "node tools/e2e.mjs",
    "build": "node tools/build-dist.mjs",
    "deploy": "npm run build && wrangler deploy",
    "e2e:undo": "node tools/undo-e2e.mjs",
    "promo": "node tools/promo/record.mjs && node tools/promo/finalize-audio.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright-core": "^1.64.0",
    "wrangler": "^4.149.0"
  }
}
